# Salin menjadi .env lalu sesuaikan. Jangan pernah commit berkas .env.
EUROGRID_DATA_DIR=./data
ENERGY_CHARTS_BASE_URL=https://api.energy-charts.info
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
HTTP_TIMEOUT_SECONDS=30
EUROGRID_USER_AGENT=eurogrid-intelligence/0.1 (isi-email-kamu@kampus.ac.id)

# ENTSO-E, isi setelah token aktif. Token asli hanya di .env, jangan di berkas ini.
ENTSOE_API_TOKEN=
ENTSOE_API_URL=https://web-api.tp.entsoe.eu/api

# Garage S3
GARAGE_S3_ENDPOINT=http://localhost:3900
GARAGE_S3_REGION=garage
GARAGE_S3_ACCESS_KEY=
GARAGE_S3_SECRET_KEY=
GARAGE_BUCKET_BRONZE=eurogrid-bronze
GARAGE_BUCKET_WAREHOUSE=eurogrid-warehouse

# Iceberg
ICEBERG_CATALOG_URI=http://localhost:8181
ICEBERG_WAREHOUSE=s3://eurogrid-warehouse/
ICEBERG_NAMESPACE=bronze

# Postgres untuk backend katalog Iceberg. Ganti dengan nilai acak sendiri.
POSTGRES_PASSWORD=

# Prefect
PREFECT_API_URL=http://localhost:4200/api
PREFECT_WORK_POOL=eurogrid-pool

# Redpanda
REDPANDA_BROKERS=localhost:9092
REDPANDA_TOPIC=eurogrid.events
REDPANDA_DLQ_TOPIC=eurogrid.events.dlq

# Serving
TRINO_URL=http://localhost:8081
API_JWT_SECRET=
MLFLOW_TRACKING_URI=http://localhost:5000
